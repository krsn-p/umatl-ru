{
    "title": "К Арима Кинен",
    "text_block_list": [
        {
            "text": "День Арима Кинен наконец настал."
        },
        {
            "name": "Спешл Уик",
            "text": "Привет, Грас!"
        },
        {
            "name": "Грасс Вандер",
            "text": "А... Привет, Спе."
        },
        {
            "name": "Грасс Вандер",
            "text": "Хе-хе, сегодня тот самый день."
        },
        {
            "name": "Спешл Уик",
            "text": "...Ага."
        },
        {
            "name": "Спешл Уик",
            "text": "И... я собираюсь выиграть."
        },
        {
            "name": "Грасс Вандер",
            "text": "...!"
        },
        {
            "name": "Спешл Уик",
            "text": "Я собираюсь победить тебя и стать лучшей в<n>\nЯпонии! Первое место на кону, так что<n>\nпостарайся!"
        },
        {
            "name": "Грасс Вандер",
            "text": "...Хе-хе."
        },
        {
            "name": "Грасс Вандер",
            "text": "Ты знаешь, я постараюсь. Я буду бежать со<n>\nвсем, что у меня есть."
        },
        {
            "name": "Спешл Уик",
            "text": "Ладненько... Я пошла, Тренер!"
        }
    ]
}